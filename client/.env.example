# ==============================================
# OpenBook Client Environment Variables
# ==============================================

# Public API URL (Backend endpoint accessed from browser)
# Local: http://localhost:8081 | Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8081

# Public Auth Base URL (Better Auth backend endpoint)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:8081

# Internal Server-Side Proxy / SSR Backend URL (Optional)
BACKEND_INTERNAL_URL=http://localhost:8081
