# ==============================================
# OpenBook Server Environment Variables
# ==============================================

# Server Configuration
PORT=8081
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8081

# PostgreSQL Database (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openbook

# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_32_characters_minimum
BETTER_AUTH_URL=http://localhost:8081

# Google OAuth (Optional - for Google Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth (login/signup + private repo imports)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# REQUIRED in production — must match GitHub OAuth App callback exactly:
GITHUB_REDIRECT_URI=https://openbook.swamiabhishek45.online/api/integrations/github/callback

# AI Models & LLM APIs
OPENAI_API_KEY=sk-proj-your_openai_api_key
# Optional: vision model for image source OCR (defaults to gpt-4o-mini)
# OCR_VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key

# ElevenLabs Voice Synthesis (For Debate Podcasts & Live Interruption Voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Pinecone Vector Database (For RAG Semantic Search)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=openbook
EMBEDDING_DIMENSIONS=512

# RAG retrieval & reranking
RAG_RETRIEVE_K=20
RAG_TOP_K=6
RAG_MIN_SCORE=0.20
RERANK_ENABLED=true
RERANK_MODEL=rerank-v3.5
COHERE_API_KEY=your_cohere_api_key
CITATION_FALLBACK_TOP_N=1
QUERY_EMBED_CACHE_TTL_SEC=86400

# Web Scraping & Search APIs
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key
TAVILY_API_KEY=tvly-your_tavily_api_key

# Cloudinary Media Storage (PDFs & Podcast MP3 Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Memory & Embeddings (Optional)
MEM0_API_KEY=m0-your_mem0_api_key

# Inngest Background Worker (0 for production, 1 for local development)
INNGEST_DEV=1

# Razorpay Payments & Subscriptions (Pro Tier)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
