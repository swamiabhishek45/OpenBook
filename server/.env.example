# ==============================================
# OpenBook Server Environment Variables
# ==============================================

# Server Configuration
PORT=8081
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8081

# PostgreSQL Database (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openbook

# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_32_characters_minimum
BETTER_AUTH_URL=http://localhost:8081

# Google OAuth (Optional - for Google Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth (login/signup + private repo imports)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Register both callback URLs in your GitHub OAuth App:
#   Login:       http://localhost:8081/api/auth/callback/github
#   Integration: http://localhost:8081/api/integrations/github/callback
# GITHUB_REDIRECT_URI=http://localhost:8081/api/integrations/github/callback

# AI Models & LLM APIs
OPENAI_API_KEY=sk-proj-your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# ElevenLabs Voice Synthesis (For Debate Podcasts & Live Interruption Voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Pinecone Vector Database (For RAG Semantic Search)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=openbook

# Web Scraping & Search APIs
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key
TAVILY_API_KEY=tvly-your_tavily_api_key

# Cloudinary Media Storage (PDFs & Podcast MP3 Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Memory & Embeddings (Optional)
MEM0_API_KEY=m0-your_mem0_api_key

# Inngest Background Worker (0 for production, 1 for local development)
INNGEST_DEV=1

# Razorpay Payments & Subscriptions (Pro Tier)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
